# Copy to .runtime/controller/service.env and replace the serial port.
export IR_SERIAL_PORT=/dev/cu.usbserial-XXXX
# For a tunnel, use your exact HTTPS origin instead of this local default.
export IR_PUBLIC_ORIGIN=http://127.0.0.1:8768
# Optional: keep the database and credentials in a different private directory.
# export IR_DATA_DIR=/absolute/private/path/controller
